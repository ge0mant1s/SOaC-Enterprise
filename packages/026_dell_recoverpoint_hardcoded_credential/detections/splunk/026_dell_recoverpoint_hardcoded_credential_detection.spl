// Dell RecoverPoint for Virtual Machines Hardcoded Credential Exploitation — Splunk detection
// MITRE: T1078, T1133, T1059, T1543, T1021
// Behavioral/engineering logic unless an IOC is cited inline.
index=recoverpoint ("session opened for user root" OR "Accepted" OR "new service")
| rex field=_raw "from (?<src_ip>\d{1,3}(?:\.\d{1,3}){3})"
| stats dc(host) as nodes values(host) as hosts count by src_ip
| where nodes>1 OR count>5
