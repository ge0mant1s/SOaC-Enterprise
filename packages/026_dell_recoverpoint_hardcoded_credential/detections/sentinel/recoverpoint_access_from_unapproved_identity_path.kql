// Behavioral: successful RecoverPoint appliance access from a source/account not in the approved management inventory.
let approvedSources = dynamic(["10.0.0.0/8_mgmt"]);
Syslog
| where Computer has "recoverpoint" or SyslogMessage has "RecoverPoint"
| where SyslogMessage has_any ("Accepted", "login", "session opened")
| extend src = extract(@"from ([0-9]{1,3}(?:\.[0-9]{1,3}){3})", 1, SyslogMessage), user = extract(@"for ([A-Za-z0-9_\-]+)", 1, SyslogMessage)
| where isnotempty(src)
| project TimeGenerated, Computer, src, user, SyslogMessage
